{
  "name": "foliofarer",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "pnpm generate:journey-v3",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "generate:journey-v2": "node scripts/journey-v2/generate.ts",
    "generate:journey-v3": "node scripts/journey-v2/generate-v3.ts",
    "validate:journey-v2": "node scripts/journey-v2/validate.ts",
    "validate:journey-v3": "node scripts/journey-v2/validate-v3.ts",
    "test:unit": "node --test --experimental-strip-types tests/journey-v2/*.test.ts",
    "test:journey": "pnpm build && playwright test --config=playwright.journey-v2.config.ts",
    "test:journey:legacy": "pnpm build && playwright test --config=playwright.config.ts",
    "test:journey:update": "pnpm build && playwright test --config=playwright.journey-v2.config.ts --update-snapshots"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/rapier": "^2.2.0",
    "@tabler/icons-react": "^3.44.0",
    "earcut": "^3.2.3",
    "next": "16.1.7",
    "polygon-clipping": "^0.15.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@thi.ng/geom-accel": "^4.1.97",
    "@thi.ng/poisson": "^3.2.97",
    "@types/earcut": "^3.0.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.1.7",
    "postcss": "^8",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "simplex-noise": "^4.0.3",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3"
  }
}
